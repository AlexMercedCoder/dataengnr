---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const termsEntries = await getCollection('terms');
  return termsEntries.map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Wait, in Astro v5 content layer with glob loader, the content is rendered differently.
// Let's check how rendering works. Wait, `entry.render()` is not available for `glob` loader unless we use `render()` from `astro:content`.
// Oh, actually the easiest way in Astro v5 is to use the `render` function from `astro:content`.
import { render } from 'astro:content';
const { Content } = await render(entry);

const termJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": entry.data.title,
  "description": entry.data.description,
  "url": `https://dataengnr.com/terms/${entry.id}/`,
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "name": "DataEngr.com Data Engineering Knowledge Base",
    "url": "https://dataengnr.com/terms/"
  },
  "author": { "@id": "https://dataengnr.com/#person" }
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} jsonLd={termJsonLd}>
  <article class="py-12 max-w-[800px] mx-auto w-full">
    <div class="mb-12 border-b border-ash-text/20 pb-8">
      <a href="/terms" class="text-sm font-medium text-ash-text hover:text-pure-white transition-colors mb-6 inline-flex items-center gap-2">
        <span aria-hidden="true">&larr;</span> Back to Knowledge Base
      </a>
      <h1 class="font-ivy text-heading-lg text-pure-white mt-4">{entry.data.title}</h1>
      <p class="text-subheading text-white-frost mt-4">{entry.data.description}</p>
      {entry.data.tags && (
        <div class="flex flex-wrap gap-2 mt-6">
          {entry.data.tags.map((tag: string) => (
            <span class="bg-midnight-ink text-silver-text text-xs font-semibold px-3 py-1 rounded-full border border-ash-text/20">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    
    <div class="prose prose-invert prose-lg max-w-none prose-headings:font-ivy prose-headings:font-medium prose-a:text-golden-gradient hover:prose-a:text-pure-white prose-p:text-porcelain-text">
      <Content />
    </div>
  </article>
</BaseLayout>
