---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { XMLParser } from 'fast-xml-parser';

// Fetch and parse RSS feed at build time
const response = await fetch('https://datalakehousehub.com/rss.xml');
const xmlData = await response.text();
const parser = new XMLParser();
const jsonObj = parser.parse(xmlData);

let allItems = [];
if (jsonObj && jsonObj.rss && jsonObj.rss.channel && jsonObj.rss.channel.item) {
  allItems = Array.isArray(jsonObj.rss.channel.item) ? jsonObj.rss.channel.item : [jsonObj.rss.channel.item];
}

// Clean and categorize items
// Assuming the item structure has title, link, description, pubDate
const articles = allItems.map(item => {
  let rawDesc = item.description || item['content:encoded'] || '';
  // Strip HTML tags for clean excerpt
  let textDesc = rawDesc.replace(/<[^>]+>/g, '').substring(0, 160).trim();
  if (rawDesc.length > 160) textDesc += '...';
  
  return {
    title: item.title,
    url: item.link,
    date: item.pubDate ? new Date(item.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '',
    excerpt: textDesc,
  };
}).filter(article => article.title && article.title !== 'Latest Articles');
---

<BaseLayout title="Blogroll" description="Aggregated blogs and articles from DataLakehouseHub.com">
  <section class="py-12">
    <div class="flex items-center justify-between mb-8 border-b border-ash-text/20 pb-4">
      <h1 class="font-ivy text-heading-lg text-pure-white">Data Engineering Blogroll</h1>
    </div>
    
    <div class="mb-12 max-w-2xl">
      <p class="text-white-frost text-body mb-6">Discover the latest articles, tutorials, and insights curated from DataLakehouseHub.com.</p>
      
      <!-- Client-side search implementation -->
      <div class="relative">
        <input 
          type="text" 
          id="blog-search" 
          placeholder="Search articles by title or keyword..." 
          class="w-full bg-charcoal-canvas text-pure-white border border-ash-text/20 rounded-full px-6 py-4 focus:outline-none focus:border-golden-gradient transition-colors"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute right-6 top-1/2 -translate-y-1/2 text-ash-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article: any) => (
        <a href={article.url} target="_blank" class="blog-card block h-full group" data-title={article.title.toLowerCase()} data-excerpt={article.excerpt.toLowerCase()}>
          <Card hoverEffect={true} class="flex flex-col h-full bg-charcoal-canvas">
            <span class="text-xs font-semibold tracking-wider text-ash-text uppercase mb-2 block">{article.date}</span>
            <h3 class="text-subheading font-semibold text-pure-white mb-3 group-hover:text-golden-gradient transition-colors line-clamp-3">{article.title}</h3>
            <p class="text-sm text-ash-text mb-6 line-clamp-3 flex-grow">{article.excerpt}</p>
            <span class="text-sm font-medium text-white-frost mt-auto inline-flex items-center gap-2 group-hover:text-pure-white transition-colors">
              Read Article <span aria-hidden="true">&rarr;</span>
            </span>
          </Card>
        </a>
      ))}
    </div>
    
    <div id="no-results" class="hidden text-center py-20 text-ash-text">
      <p class="text-lg">No articles found matching your search.</p>
    </div>
  </section>

  <script>
    // Client-side search logic
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('blog-search') as HTMLInputElement;
      const blogCards = document.querySelectorAll('.blog-card');
      const noResults = document.getElementById('no-results');

      if (!searchInput) return;

      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        let visibleCount = 0;

        blogCards.forEach((card: any) => {
          const title = card.getAttribute('data-title') || '';
          const excerpt = card.getAttribute('data-excerpt') || '';
          
          if (title.includes(query) || excerpt.includes(query)) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  </script>
</BaseLayout>
