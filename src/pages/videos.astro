---
// /videos: the DataEngr.com video explainer gallery.
// Animated 16:9 explainers rendered from a shared HyperFrames template: no
// narration and no audio track at all, so every point is on screen. The
// manifest is generated by the video workspace's sync-to-site.mjs
// (~/development/dataengnr-videos).
import BaseLayout from '../layouts/BaseLayout.astro';
import videos from '../data/videos.json';

const SITE = 'https://dataengnr.com';
const canonicalURL = `${SITE}/videos`;
const abs = (p: string) => `${SITE}${p}`;

const title = 'Data Engineering Video Explainers';
const description =
  'Short animated explainers on data engineering: what the discipline is, ETL vs ELT, batch vs streaming, warehouse vs lake vs lakehouse, data modeling, orchestration, data quality and the modern data stack.';

// The date this gallery was first published. VideoObject requires uploadDate.
const UPLOAD_DATE = '2026-08-08';

const creator = {
  "@type": "Person",
  "@id": `${SITE}/#person`,
  "name": "Alex Merced",
};

const videoSchemas = videos.map((v: any) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${canonicalURL}#${v.slug}`,
  "name": v.title,
  "description": v.description,
  "thumbnailUrl": [abs(v.poster)],
  "uploadDate": UPLOAD_DATE,
  "duration": v.iso8601,
  "contentUrl": abs(v.src),
  "encodingFormat": "video/mp4",
  "width": v.width,
  "height": v.height,
  "inLanguage": "en",
  "isFamilyFriendly": true,
  "keywords": v.keywords.join(', '),
  "creator": creator,
  "publisher": { "@id": `${SITE}/#person` },
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalURL}#collection`,
  "name": title,
  "description": description,
  "url": canonicalURL,
  "isPartOf": { "@id": `${SITE}/#website` },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": videos.length,
    "itemListElement": videos.map((v: any, i: number) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `${canonicalURL}#${v.slug}`,
      "name": v.title,
    })),
  },
};

const breadcrumbs = [{ name: 'Home', href: '/' }];

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---

<BaseLayout
  title="Videos"
  description={description}
  jsonLd={[...videoSchemas, collectionSchema]}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-ash-text">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-pure-white transition-colors">Home</a></li>
        <li aria-hidden="true">&rsaquo;</li>
        <li aria-current="page" class="text-silver-text">Videos</li>
      </ol>
    </nav>

    <header class="mb-14 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-golden-gradient mb-3">
        Video explainers
      </p>
      <h1 class="font-ivy text-heading-lg text-pure-white">
        Data engineering, explained in under a minute each
      </h1>
      <p class="text-body text-white-frost mt-5">
        Eight short animated explainers covering the questions that come up first: what data
        engineering actually is, how ETL and ELT differ, when batch beats streaming, where
        analytical data should live, how analytical models are shaped, what an orchestrator buys
        you, how quality is measured, and what the modern stack is made of. There is no narration
        and no audio track at all, so every point is on screen. They read the same muted, in a
        meeting, or embedded in your own docs.
      </p>
    </header>

    {videos.length === 0 ? (
      <p class="py-12 text-center text-ash-text">Videos are being published. Check back shortly.</p>
    ) : (
      <ul role="list" class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        {videos.map((v: any) => (
          <li id={v.slug} class="flex flex-col overflow-hidden rounded-md border border-ash-text/10 bg-charcoal-canvas scroll-mt-24 transition-colors hover:border-golden-gradient/50">
            <div class="relative aspect-video w-full bg-midnight-ink">
              <video
                class="video-el absolute inset-0 block h-full w-full"
                controls
                playsinline
                muted
                preload="metadata"
                poster={v.poster}
                width={v.width}
                height={v.height}
                aria-label={`${v.title}, silent animated explainer, ${fmt(v.seconds)}`}
              >
                <source src={v.src} type="video/mp4" />
                Your browser does not support the video tag.
                <a href={v.src}>Download the MP4</a>.
              </video>
              <span class="pointer-events-none absolute right-2 top-2 rounded bg-midnight-ink/70 px-2 py-1 text-xs font-bold text-white-frost" aria-hidden="true">
                {fmt(v.seconds)}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h2 class="flex items-baseline gap-2 text-subheading font-semibold text-pure-white">
                <span class="text-sm font-bold text-golden-gradient">{String(v.index).padStart(2, '0')}</span>
                {v.title}
              </h2>
              <p class="mt-3 text-sm text-white-frost leading-relaxed">{v.description}</p>
              <ul role="list" class="mt-4 flex flex-col gap-2 border-t border-ash-text/10 pt-4">
                {v.beats.map((b: string) => (
                  <li class="relative pl-4 text-sm text-ash-text">
                    <span class="absolute left-0 top-[0.62em] h-px w-2 bg-golden-gradient" aria-hidden="true"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-12 text-center text-sm text-ash-text">
      Silent by design: no narration, no music. Hover to preview, click to play, or download any
      MP4 and reuse it. Every topic here has a longer write-up in the
      <a href="/terms" class="text-golden-gradient hover:text-pure-white transition-colors">knowledge base</a>.
    </p>
  </section>
</BaseLayout>

<script>
  // The clips carry no audio track, so a muted hover-preview costs the viewer
  // nothing and autoplay policies never block it. Three behaviours only:
  //   1. hover (fine-pointer devices only) previews from the start;
  //   2. leaving resets to the poster, unless the viewer pressed play;
  //   3. starting one video pauses whichever one was already going.
  function setupVideoGallery() {
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.video-el'));
    if (!videos.length) return;

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const intentional = new WeakSet<HTMLVideoElement>();

    videos.forEach((video) => {
      video.addEventListener('play', () => {
        videos.forEach((other) => {
          if (other !== video && !other.paused) other.pause();
        });
      });

      // A click on the native controls is a deliberate play, so stop treating
      // this element as a hover preview from then on.
      video.addEventListener('click', () => intentional.add(video));

      if (!canHover) return;

      video.addEventListener('mouseenter', () => {
        if (intentional.has(video)) return;
        video.currentTime = 0;
        void video.play().catch(() => {});
      });

      video.addEventListener('mouseleave', () => {
        if (intentional.has(video)) return;
        video.pause();
        video.currentTime = 0;
      });
    });
  }

  setupVideoGallery();
  document.addEventListener('astro:after-swap', setupVideoGallery);
</script>
