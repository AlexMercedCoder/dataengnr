---
import '../styles/global.css';
import GhostLink from '../components/GhostLink.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  jsonLd?: object;
}

const { 
  title, 
  description = "Premier resource hub for data engineers. Learn about Apache Iceberg, data lakehouses, and agentic analytics.",
  canonicalUrl = Astro.url.href,
  jsonLd
} = Astro.props;

const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://dataengnr.com/#website",
      "url": "https://dataengnr.com/",
      "name": "DataEngr.com",
      "description": "Premier resource hub for data engineers covering Apache Iceberg, data lakehouses, and agentic analytics.",
      "publisher": { "@id": "https://dataengnr.com/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://dataengnr.com/#person",
      "name": "Alex Merced",
      "jobTitle": "Head of Developer Relations at Dremio",
      "url": "https://whoisalexmerced.com",
      "sameAs": [
        "https://whoisalexmerced.com",
        "https://alexmerced.com",
        "https://alexmerceddata.com",
        "https://www.linkedin.com/in/alexmerced",
        "https://twitter.com/alexmercedcoder"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-midnight-ink text-pure-white font-inter antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | DataEngr.com</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | DataEngr.com`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://dataengnr.com/og-image.png" />
    <meta property="og:site_name" content="DataEngr.com" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alexmercedcoder" />
    <meta name="twitter:title" content={`${title} | DataEngr.com`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dataengnr.com/og-image.png" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col bg-midnight-ink text-pure-white font-inter">
    <!-- Sticky Nav -->
    <header class="sticky top-0 z-50 bg-midnight-ink/80 backdrop-blur-md border-b border-ash-text/20">
      <div class="max-w-[1216px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-ivy font-medium text-2xl tracking-wide text-pure-white hover:text-white-frost transition-colors">
          DataEngr.com
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <GhostLink href="/search">Search</GhostLink>
          <GhostLink href="/terms">Knowledge Base</GhostLink>
          <GhostLink href="/blogroll">Blogroll</GhostLink>
          <GhostLink href="/books">Books</GhostLink>
        </nav>
      </div>
    </header>

    <main data-pagefind-body class="flex-grow w-full max-w-[1216px] mx-auto px-6 py-12 md:py-20 flex flex-col gap-[160px]">
      <slot />
    </main>

    <footer class="border-t border-ash-text/20 py-12 mt-auto">
      <div class="max-w-[1216px] mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-ash-text">
        <p>&copy; {new Date().getFullYear()} Alex Merced. All rights reserved.</p>
        <div class="flex flex-wrap justify-center md:justify-end gap-x-4 gap-y-2">
          <a href="https://whoisalexmerced.com" target="_blank" class="hover:text-pure-white transition-colors">About Alex</a>
          <a href="https://alexmerced.com" target="_blank" class="hover:text-pure-white transition-colors">AlexMerced.com</a>
          <a href="https://alexmerceddata.com" target="_blank" class="hover:text-pure-white transition-colors">Data</a>
          <a href="https://alexmercedmedia.com" target="_blank" class="hover:text-pure-white transition-colors">Media</a>
          <a href="https://books.alexmerced.com" target="_blank" class="hover:text-pure-white transition-colors">Books</a>
          <a href="https://alexmercedcoder.dev" target="_blank" class="hover:text-pure-white transition-colors">Coder</a>
          <a href="https://alexmercedlibertarian.com" target="_blank" class="hover:text-pure-white transition-colors">Libertarian</a>
          <a href="https://agenticlakehouse.com" target="_blank" class="hover:text-pure-white transition-colors">Agentic Lakehouse</a>
          <a href="https://semanticlakehouse.com" target="_blank" class="hover:text-pure-white transition-colors">Semantic Lakehouse</a>
        </div>
      </div>
    </footer>
  </body>
</html>
