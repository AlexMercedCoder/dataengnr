---
import '../styles/global.css';
import GhostLink from '../components/GhostLink.astro';
import networkHead from '../../network/network-head.html?raw';
import network from '../../network/network.json';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  /** Full-length page summary. Shown on-page where relevant and trimmed for <meta name="description">. */
  description?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
  ogType?: string;
  /** Trail from the home page to this page, excluding this page itself. */
  breadcrumbs?: Crumb[];
  /** Set when the page supplies its own full <title> and should not get the site suffix. */
  bareTitle?: boolean;
  /** Keep the page out of search indexes (utility pages such as /search). */
  noindex?: boolean;
}

const SITE = 'https://dataengnr.com';

const {
  title,
  description = "A data engineering knowledge base: 200+ plain-language definitions covering pipelines, lakehouses, Apache Iceberg, modeling, orchestration and AI-era analytics.",
  canonicalUrl = new URL(Astro.url.pathname, SITE).href,
  jsonLd,
  ogType = "website",
  breadcrumbs = [],
  bareTitle = false,
  noindex = false,
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} | DataEngnr`;

// Search engines truncate around 160 characters. Term descriptions are written
// to read as a full definition on the page, so trim a copy for the meta tag
// rather than shortening the source text.
function metaDescription(text: string, max = 158) {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:]$/, '') + '...';
}

const metaDesc = metaDescription(description);

const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": `${SITE}/`,
      "name": "DataEngnr",
      "description":
        "A data engineering knowledge base covering pipelines, lakehouse architecture, Apache Iceberg and AI-era analytics.",
      "inLanguage": "en",
      "publisher": { "@id": "https://alexmerced.com/#alexmerced" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${SITE}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};

const breadcrumbJsonLd =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [...breadcrumbs, { name: title, href: Astro.url.pathname }].map(
          (c, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": c.name,
            "item": new URL(c.href, SITE).href,
          })
        ),
      }
    : null;

const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const navLinks = [
  { href: '/terms', label: 'Knowledge Base' },
  { href: '/videos', label: 'Videos' },
  { href: '/blogroll', label: 'Blogroll' },
  { href: '/books', label: 'Books' },
  { href: '/search', label: 'Search' },
];
---

<!DOCTYPE html>
<html lang="en" class="bg-midnight-ink text-pure-white font-inter antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="author" content="Alex Merced" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content="https://dataengnr.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DataEngnr, a data engineering knowledge base" />
    <meta property="og:site_name" content="DataEngnr" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={network.twitterSite} />
    <meta name="twitter:creator" content="@alexmercedcoder" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content="https://dataengnr.com/og-image.png" />

    <!-- Network: GA4, click events and the canonical Person entity (generated, do not edit) -->
    <Fragment set:html={networkHead} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    {extraJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col bg-midnight-ink text-pure-white font-inter">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-4 focus:rounded-md focus:bg-pure-white focus:px-4 focus:py-2 focus:text-midnight-ink">
      Skip to content
    </a>

    <!-- Sticky Nav -->
    <header class="sticky top-0 z-50 bg-midnight-ink/80 backdrop-blur-md border-b border-ash-text/20">
      <div class="max-w-[1216px] mx-auto px-6 py-3 md:h-16 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
        <a href="/" class="font-ivy font-medium text-2xl tracking-wide text-pure-white hover:text-white-frost transition-colors">
          DataEngnr
        </a>
        <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm md:text-base">
          {navLinks.map((link) => (
            <GhostLink href={link.href} class="!py-1 md:!py-5">{link.label}</GhostLink>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" data-pagefind-body class="flex-grow w-full max-w-[1216px] mx-auto px-6 py-12 md:py-20 flex flex-col gap-[160px]">
      <slot />
    </main>

    {network.cta && (
      <section aria-labelledby="network-cta-heading" class="border-t border-ash-text/20 bg-charcoal-canvas/60">
        <div class="max-w-[1216px] mx-auto px-6 py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <h2 id="network-cta-heading" class="font-ivy text-heading text-pure-white">{network.cta.heading}</h2>
          <ul class="flex flex-wrap gap-3">
            {network.cta.links.map((link) => (
              <li>
                <a href={link.url} data-network-event={link.event} target="_blank" rel="noopener noreferrer" class="inline-block rounded-full border border-golden-gradient/60 px-5 py-2 text-sm text-pure-white hover:bg-golden-gradient hover:text-midnight-ink transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <footer class="border-t border-ash-text/20 py-12 mt-auto">
      <div class="max-w-[1216px] mx-auto px-6 flex flex-col gap-8">
        <nav aria-label="Site" class="flex flex-wrap justify-center md:justify-start gap-x-5 gap-y-2 text-sm text-ash-text">
          <a href="/terms" class="hover:text-pure-white transition-colors">Knowledge Base</a>
          <a href="/videos" class="hover:text-pure-white transition-colors">Videos</a>
          <a href="/blogroll" class="hover:text-pure-white transition-colors">Blogroll</a>
          <a href="/books" class="hover:text-pure-white transition-colors">Books</a>
          <a href="/search" class="hover:text-pure-white transition-colors">Search</a>
        </nav>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-ash-text">
          <p>&copy; {new Date().getFullYear()} Alex Merced. All rights reserved.</p>
        </div>
        <nav aria-label="The Alex Merced Network" class="border-t border-ash-text/20 pt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-golden-gradient mb-6">The Alex Merced Network</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
            {network.footer.groups.map((group) => (
              <div>
                <h3 class="text-sm font-semibold text-pure-white mb-3">{group.title}</h3>
                <ul class="flex flex-col gap-2 text-sm text-ash-text">
                  {group.links.map((link) => (
                    <li><a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">{link.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="mt-6 text-sm">
            <a href={network.footer.allSitesUrl} target="_blank" rel="noopener noreferrer" class="text-golden-gradient hover:text-pure-white transition-colors">{network.footer.allSitesLabel} <span aria-hidden="true">&rarr;</span></a>
          </p>
        </nav>
        <nav aria-label="Free weekly newsletters" class="border-t border-ash-text/20 pt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-golden-gradient mb-4">Free Weekly Newsletters</h2>
          <ul class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ash-text footer-run-list">
            <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">AI newsletter, Thursdays</a></li>
            <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Apache lakehouse newsletter, Fridays</a></li>
            <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Subscribe on Substack</a></li>
          </ul>
        </nav>
        <nav aria-label="Events and community" class="border-t border-ash-text/20 pt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-golden-gradient mb-4">Events &amp; Community</h2>
          <ul class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ash-text footer-run-list">
            <li><a href="https://luma.com/agenticlakehouse" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Agentic Lakehouse Events</a></li>
            <li><a href="https://luma.com/DataLakehouseHub" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Data Lakehouse Hub Events</a></li>
            <li><a href="https://join.slack.com/t/thedatalakehousehub/shared_invite/zt-274yc8sza-mI2zhCW8LGkOh1uxuf8T5Q" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Data Lakehouse Hub Slack</a></li>
            <li><a href="https://join.slack.com/t/data-events/shared_invite/zt-38vgrooy9-U9ral_gr3NAz_Siih1QwmQ" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Data Events Slack</a></li>
            <li><a href="https://join.slack.com/t/datatechcommunity/shared_invite/zt-12xrk4qmd-y~6jUFFd7kdaLhgLURKwoA" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Data &amp; Tech Slack</a></li>
            <li><a href="https://www.reddit.com/r/datalakehouseandai/" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">r/datalakehouseandai</a></li>
            <li><a href="https://www.linkedin.com/company/data-lakehouse-hub/" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Data Lakehouse Hub on LinkedIn</a></li>
            <li><a href="https://www.youtube.com/@AlexMercedCoder" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Alex Merced Tech on YouTube</a></li>
            <li><a href="https://www.youtube.com/@alexmerceddata" target="_blank" rel="noopener noreferrer" class="hover:text-pure-white transition-colors">Alex Merced Data &amp; AI on YouTube</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <!-- WebMCP: read-only tools for browser AI agents. Progressive enhancement;
       no effect where WebMCP is unsupported. Config in /webmcp/init.js -->
  <script src="/webmcp/alex-merced-webmcp.js" defer></script>
  <script src="/webmcp/init.js" defer></script>
</body>
</html>
